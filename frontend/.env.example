# ============================================================================
# Enterprise Document Management System (DMS) - Frontend Configuration Example
# Copy this file to .env, .env.development, or .env.production
# ============================================================================

# Backend API Base URL
# Local Development default:
VITE_API_BASE_URL=http://localhost:5000/api

# Azure VM / Production direct host example:
# VITE_API_BASE_URL=http://<YOUR_SERVER_IP_OR_DOMAIN>:5000/api

# Production reverse-proxy (Nginx / same-domain) example:
# VITE_API_BASE_URL=/api

# Optional: Dedicated Socket.IO Server URL (defaults to VITE_API_BASE_URL without /api)
# VITE_SOCKET_URL=http://localhost:5000
